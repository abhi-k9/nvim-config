# .clangd — project-level clangd configuration.
#
# PLACEMENT: put this at your PROJECT ROOT (e.g. <project-root>/.clangd),
# NOT in your Neovim config. clangd discovers it by walking up from the
# file being edited; it has nothing to do with the editor.
#
# WHY THIS EXISTS: most build systems don't compile headers directly, so
# compile_commands.json usually has no entry for them. clangd can borrow
# flags from an opened source that includes the header, or infer a command
# from similar file names in the database. If neither is available, it uses
# a fallback command. Any borrowed/default command with the wrong standard
# or missing include paths/macros can produce misleading diagnostics.
#
# WHAT IT DOES: the Add flag below is appended to the compile command of
# EVERY C++ file clangd parses — sources with a database entry, and those
# orphan-header fallback parses alike. clangd appends Add flags after the
# database flags and the last -std on the command line wins, so this pins
# the standard everywhere, overriding the database's own -std. That is
# what fixes header diagnostics even across an include/ vs src/ split and
# regardless of what's currently in scope, and it is right for a
# single-standard project. The PathMatch excludes .c sources but includes
# .h headers. Remove .h from the list for C headers: -std=c++20 does not
# itself change a C compile command into a C++ command.

If:
  PathMatch: .*\.(cc|cpp|cxx|c\+\+|h|hh|hpp|hxx|ipp|inl|tpp)
CompileFlags:
  # >>> Set this to YOUR project's standard: c++17 / c++20 / c++23. <<<
  # If you genuinely mix standards per target, use the headers-only block
  # at the bottom instead (and delete this one).
  Add: [-std=c++20]

# Optional: only apply the standard to headers, leaving real source TUs
# entirely on their database flags. Use this instead of the block above
# if your project mixes C++ standards across targets. Delete the block
# above if you enable this one. Paths are relative to this .clangd directory;
# this example matches C++ headers under its include/ directory. Adapt the path.
#
# If:
#   PathMatch: include/.*\.(h|hh|hpp|hxx|ipp|inl|tpp)
# CompileFlags:
#   Add: [-std=c++20]
