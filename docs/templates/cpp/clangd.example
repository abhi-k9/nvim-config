# ════════════════════════════════════════════════════════════════════════
#  .clangd — language-server configuration for clangd
# ════════════════════════════════════════════════════════════════════════
#
# WHAT THIS IS (and isn't)
# ------------------------
# This file tells clangd how to behave in your project: which compile
# flags to apply, which diagnostics to surface, what inlay hints to
# show, etc. It is SEPARATE from:
#
#   * `.clang-format` — controls code formatting only.
#   * `compile_commands.json` — describes how each translation unit is
#     built. Generated by your build system (CMake `-DCMAKE_EXPORT_COMPILE_COMMANDS=ON`,
#     Bear, or a build-system-specific exporter). xcodebuild's
#     -showBuildSettings alone does not produce this JSON database. clangd uses it to
#     understand your code; without it, you'll get false errors about
#     missing headers.
#
# WHERE TO PUT IT
# ---------------
# Project-level (this file)  →  `<project root>/.clangd`
# User-wide defaults         →  Windows: `%LOCALAPPDATA%\clangd\config.yaml`
#                              macOS:   `~/Library/Preferences/clangd/config.yaml`
#                              Linux:   `~/.config/clangd/config.yaml`
#
# Settings combine where possible. For conflicts, user-wide config wins,
# then the nearest project .clangd, then outer project configs. Drop this in
# the project root as `.clangd` (leading dot, no extension).
#
# FORMAT
# ------
# YAML. Comments start with `#`. Multiple "documents" can be separated
# by `---`, each optionally guarded by an `If:` block — this is how you
# get per-directory or per-filetype rules in a single file (see the
# commented examples at the bottom).
#
# DOCS: https://clangd.llvm.org/config
# ════════════════════════════════════════════════════════════════════════

# ─── Compile flags ──────────────────────────────────────────────────────
# How clangd should think about compiling your files. The most common
# pain points all live here:
#
#   * `CompilationDatabase` — directory (relative to this .clangd file)
#     containing compile_commands.json. Common values:
#         .          file sits next to this .clangd at the project root
#         build/     cmake out-of-source default (`cmake -B build ...`)
#         out/       some Bazel / Meson layouts
#         cmake-build-debug/, cmake-build-release/  CLion-style
#     IMPORTANT: if this points at a directory that doesn't contain
#     compile_commands.json, clangd uses a fallback command, plus the
#     Add/Remove rules here. That can lose important includes/macros;
#     inspect the LSP log's compilation-database and compile-command lines.
#     Set it to the actual location, or leave it commented to use normal
#     ancestor discovery (which also checks build/ subdirectories).
#     An explicit --compile-commands-dir, such as Scoper supplies in selected
#     or filtered mode, takes precedence over this database-search setting.
#
#   * `Add` — flags to append to every file's command line. Useful for
#     warnings you want everywhere (`-Wall`, `-Wextra`) regardless of
#     what your build system requested.
#
#   * `Remove` — flags to strip. Essential when your build system uses
#     compiler-specific flags clangd's underlying clang doesn't grok:
#     MSVC-specific `/Zc:*`, `/Yu*`, gcc's `-fno-fat-lto-objects`, etc.
#     clangd would otherwise emit "unknown argument" warnings on every
#     file.
#
#   * `Compiler` — override what clangd thinks the compiler is. Set to
#     `clang-cl` for MSVC-style flag syntax on Windows; `clang++` for
#     gcc/clang-style projects.
CompileFlags:
  # CompilationDatabase: .           # see commentary above — uncomment and set to match your layout
  Add:
    - -Wall
    - -Wextra
    - -Wpedantic
    # (-std=c++20 is pinned for C++ files only, in the last document below.)
  Remove:
    # MSVC-style flags clang doesn't recognise. Trim or extend to match
    # what your build emits — open the LSP log with
    # `:lua vim.cmd.edit(vim.lsp.log.get_filename())` to see the actual
    # rejected flags. (nvim-lspconfig's `:LspLog` is only defined on
    # Neovim < 0.12, where the built-in `:lsp` command doesn't exist.)
    - /Zc*
    - /Yu*
    - /Fp*
    - -fno-fat-lto-objects
  # Compiler: clang++                # uncomment to pin a specific driver

# ─── Semantic indexing ─────────────────────────────────────────────────
# Background indexing supplies symbols for cross-TU operations such as
# workspace symbols, references and rename. Initial indexing can be costly;
# use Skip where that cost is unsuitable. Open files still have a dynamic index.
Index:
  Background: Build                  # Build = index in background; Skip = only on-demand
  StandardLibrary: Yes               # include stdlib symbols (recommended)

# ─── Diagnostics ───────────────────────────────────────────────────────
# What clangd surfaces as squigglies. The "*Includes" checks are
# powerful but require disciplined Include-What-You-Use hygiene; if
# your project hasn't been groomed for IWYU, set both to None or you'll
# drown in warnings.
Diagnostics:
  UnusedIncludes: Strict             # flag #includes nothing references
  MissingIncludes: Strict            # flag transitive-only #includes (IWYU)
  # Suppress:                        # specific diag IDs to silence project-wide
  #   - unused-includes              #   useful when you can't fix all of them yet
  #   - missing-includes
  ClangTidy:
    # clang-tidy inside clangd. This block carries the SAME checks and
    # options as the .clang-tidy dotfile (scripts/check-docs.sh enforces
    # it), so it can stand in for that file; clang-tidy.example explains
    # each line. If both exist, clangd reads .clang-tidy first and applies
    # these Add/Remove lists on top. Wildcards are supported.
    Add:
      - bugprone-*
      - cppcoreguidelines-*
      - modernize-*
      - performance-*
      - readability-*
      - misc-*
    Remove:
      # Noisy or stylistic, not wrong — see clang-tidy.example for why:
      - modernize-use-trailing-return-type      # opinion war about `auto foo() -> int`
      - modernize-avoid-c-arrays
      - modernize-use-nodiscard
      - readability-identifier-length            # complains about `i`, `x`, etc.
      - readability-magic-numbers
      - readability-named-parameter
      - readability-braces-around-statements
      - readability-function-cognitive-complexity
      - cppcoreguidelines-avoid-magic-numbers
      - cppcoreguidelines-avoid-c-arrays         # alias of modernize-avoid-c-arrays
      - cppcoreguidelines-pro-bounds-pointer-arithmetic  # most C interop needs this
      - cppcoreguidelines-pro-bounds-array-to-pointer-decay
      - cppcoreguidelines-pro-type-vararg
      - cppcoreguidelines-non-private-member-variables-in-classes
      - cppcoreguidelines-avoid-non-const-global-variables
      - bugprone-easily-swappable-parameters
      - misc-non-private-member-variables-in-classes
      - misc-no-recursion
    CheckOptions:
      # Per-check tuning. Format: `<check>.<option>: <value>`.
      modernize-use-default-member-init.UseAssignment: 'false'
      modernize-use-default-member-init.IgnoreMacros: 'true'
      modernize-use-auto.MinTypeNameLength: '5'
      modernize-use-auto.RemoveStars: 'false'
      modernize-loop-convert.MinConfidence: 'reasonable'
      readability-identifier-naming.NamespaceCase: 'lower_case'
      readability-identifier-naming.ClassCase: 'CamelCase'
      readability-identifier-naming.StructCase: 'CamelCase'
      readability-identifier-naming.EnumCase: 'CamelCase'
      readability-identifier-naming.FunctionCase: 'lower_case'
      readability-identifier-naming.VariableCase: 'camelBack'
      readability-identifier-naming.ParameterCase: 'camelBack'
      readability-identifier-naming.MemberCase: 'lower_case'
      readability-identifier-naming.PrivateMemberSuffix: '_'
      readability-identifier-naming.ConstantCase: 'camelBack'
      readability-identifier-naming.MacroDefinitionCase: 'UPPER_CASE'
      readability-identifier-naming.EnumConstantCase: 'CamelCase'
      readability-identifier-naming.GlobalConstantCase: 'CamelCase'

# ─── Inlay hints ───────────────────────────────────────────────────────
# Ghost text overlays for parameter names, deduced types, etc. nvim
# renders these via `vim.lsp.inlay_hint`; this config controls what
# clangd produces. The on/off toggle from the editor still applies.
#
# `BlockEnd: No` because the `// for` / `// namespace foo` comments
# that follow closing braces clutter dense C++ quickly. Flip to Yes if
# you find yourself losing track of nesting in long bodies.
InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes
  Designators: Yes
  BlockEnd: No

# ─── Hover ─────────────────────────────────────────────────────────────
Hover:
  ShowAKA: Yes                       # expand typedefs: `std::string (aka std::basic_string<char>)`

# ─── Completion ────────────────────────────────────────────────────────
# `AllScopes: Yes` makes completion suggest symbols from any namespace
# (qualifying with the namespace prefix in the inserted text). Useful in
# large codebases where you can't remember which header / namespace a
# helper lives in. Set to No if completion feels noisy.
Completion:
  AllScopes: Yes

# ─── Style ─────────────────────────────────────────────────────────────
# Controls how clangd writes code it inserts (e.g. fix-its that add a
# missing #include or qualify a symbol).
Style:
  FullyQualifiedNamespaces: []       # optional namespace-name list (e.g. [std]), not a boolean

# ─── C++ standard (C++ files only) ──────────────────────────────────────
# The same pin as the .clangd dotfile. clangd appends Add flags after the
# database flags and the last -std wins, so this overrides the database's
# standard for every C++ file — sources and orphan headers alike. The
# PathMatch keeps it off C files (.h counts as C++ here). It sits in its own
# document because an `If:` scopes everything in its document.
---
If:
  PathMatch: .*\.(cc|cpp|cxx|c\+\+|h|hh|hpp|hxx|ipp|inl|tpp)
CompileFlags:
  Add: [-std=c++20]

# ════════════════════════════════════════════════════════════════════════
#  Conditional sections (uncomment / adapt as needed)
# ════════════════════════════════════════════════════════════════════════
#
# A `---` separates documents. Each can be guarded by an `If:` block
# that narrows where the rules apply. Multiple documents are merged,
# combining rules for matching files. Scalar conflicts use config precedence;
# list-like settings such as diagnostic additions/removals can accumulate.

# Example: relax diagnostics inside `tests/` since test code often
# violates rules the production code is held to.
# ---
# If:
#   PathMatch: tests/.*
# Diagnostics:
#   ClangTidy:
#     Remove:
#       - misc-no-recursion
#       - readability-function-cognitive-complexity
#       - cppcoreguidelines-avoid-non-const-global-variables

# Example: generated headers under `gen/` shouldn't trigger our checks.
# ---
# If:
#   PathMatch: gen/.*
# Diagnostics:
#   Suppress: "*"          # silence everything for generated code

# Example: a vendored third-party directory whose code we don't own —
# index it but don't lint it.
# ---
# If:
#   PathMatch: third_party/.*
# Diagnostics:
#   Suppress: "*"

# Example: per-extension overrides (Objective-C/C++ headers on macOS).
# ---
# If:
#   PathMatch: .*\.mm?
# CompileFlags:
#   Add:
#     - -xobjective-c++
#     - -fobjc-arc
