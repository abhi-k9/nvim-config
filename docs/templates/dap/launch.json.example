// ════════════════════════════════════════════════════════════════════════
//  .vscode/launch.json — per-project debug configurations for nvim-dap
// ════════════════════════════════════════════════════════════════════════
//
// WHAT THIS FILE IS
// -----------------
// nvim-dap reads `.vscode/launch.json` from its discovery root and presents
// each entry (by its `name`) when you select a new debug configuration.
// Adapter properties follow the adapter's VS Code schema; client features
// such as task integration and extension-specific commands differ:
//   https://code.visualstudio.com/docs/cpp/launch-json-reference
//
// HOW TO USE IT
// -------------
//   1. Copy this file to `<your project>/.vscode/launch.json`.
//   2. Edit `program`, `args`, `cwd`, and `environment`/`env` for your adapter.
//   3. In nvim, press <leader>dc (continue/start). Pick a configuration.
//   4. The file is re-read when selecting a NEW configuration. Continuing
//      an active session, Run Last and Restart reuse its existing config;
//      finish the session and select again to apply launch-file edits.
//      <leader>dL validates/previews the file without starting a session.
//
// WHICH ADAPTER SHOULD I USE?  (cppdbg and codelldb are both Mason-installed)
// --------------------------------------------------------------
//   cppdbg    GDB- or LLDB-backed, via Microsoft's cpptools. Most
//             VS-Code-like; great pretty-printing via gdb. Good default
//             on Linux. Uses `MIMode` to pick gdb vs lldb.
//   codelldb  A standalone LLDB-based adapter (Vadimcn's) for Rust and
//             modern C++, including Windows. It uses different field names —
//             see the big section near the bottom before you use it.
//   (lldb)    The lldb you get is via cppdbg with MIMode:"lldb" (macOS),
//             OR via codelldb. There's no separate "lldb" type here.
//
// VARIABLE SUBSTITUTIONS  (expanded by nvim-dap at launch time)
// ------------------------------------------------------------
//   ${workspaceFolder}            resolved debug root; defaults to cwd.
//                                 Change cwd with :cd/:tcd/:lcd, or set
//                                 debug.root in local.lua (see the guide).
//   ${workspaceFolderBasename}    just the folder name, no path.
//   ${file}                       full path of the current buffer.
//   ${fileBasename}               current file name, e.g. main.cpp.
//   ${fileBasenameNoExtension}    e.g. main.
//   ${fileDirname}                directory of the current file.
//   ${relativeFile}               current file relative to workspaceFolder.
//   ${env:NAME}                   value of environment variable NAME.
//   ${command:pickProcess}        process picker (used for attach below).
//
// FORMAT NOTES
// ------------
//   * Comments are fine: nvim-dap decodes with comment skipping, so // and
//     /* */ comments may sit anywhere, including at the end of a line.
//   * Trailing commas are NOT: nvim-dap reads standard JSON, so a comma
//     after the last item of a list or object is a parse error (unlike
//     VS Code). `:DapLoadLaunchJSON` (<leader>dL) reports it.
//   * `version` is conventionally "0.2.0"; nvim-dap doesn't enforce it.
//   * Every config needs at least: name, type, request. The rest depend
//     on the adapter and whether you're launching or attaching.
//
// SYSTEM-SPECIFIC PROPERTIES  (nvim-dap feature, also in VS Code)
// ---------------------------------------------------------------
// A config may carry `linux:`, `osx:`, and `windows:` sub-objects whose
// keys are merged in (overriding the top level) only on that OS. This
// lets ONE config work cross-platform — e.g. a different debugger path
// or program extension per system:
//   {
//     "name": "Debug (cross-platform)",
//     "type": "cppdbg", "request": "launch", "MIMode": "gdb",
//     "program": "${workspaceFolder}/build/Debug/app",
//     "windows": { "program": "${workspaceFolder}/build/Debug/app.exe",
//                  "miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe" },
//     "osx":     { "MIMode": "lldb" }
//   }
//
// preLaunchTask / postDebugTask  — NOT supported by nvim-dap core
// ---------------------------------------------------------------
// VS Code runs a `preLaunchTask` (usually a build) before launching.
// nvim-dap core IGNORES these fields — adding `"preLaunchTask": "build"`
// does nothing on its own. Options:
//   * Build yourself before <leader>dc (e.g. `:make`, or a build in a <leader>tt terminal).
//   * Configure a task plugin's explicit DAP integration if you need task
//     orchestration. No such integration is bundled here.
// Don't rely on the binary being rebuilt automatically when you start a
// session — stale-binary debugging is a classic "my breakpoint moved"
// trap.
//
// ════════════════════════════════════════════════════════════════════════
{
  "version": "0.2.0",
  "configurations": [

    // ════════════════════════════════════════════════════════════════════
    //  cppdbg (GDB) — the bread-and-butter Linux config
    // ════════════════════════════════════════════════════════════════════
    // Launches a freshly-built binary with no arguments, project root as
    // the working directory. This is the one to copy first.
    {
      "name": "Debug ‹app› (Debug build)",
      "type": "cppdbg",
      "request": "launch",

      // Path to the COMPILED EXECUTABLE — not your source file. Build with
      // debug symbols (-g for gcc/clang, or a CMake "Debug" config) or
      // breakpoints won't bind and you'll see "no symbol table".
      "program": "${workspaceFolder}/build/Debug/app",

      // Command-line arguments, one array element per argument. Quoting is
      // automatic — DON'T wrap things in extra quotes. See the next config
      // for an example with real args.
      "args": [],

      // Working directory the program runs in. Matters for relative paths
      // your program opens (config files, test fixtures, etc.).
      "cwd": "${workspaceFolder}",

      // Break automatically on entry (at main)? Usually false — set a
      // breakpoint where you actually care instead. cppdbg spells this
      // "stopAtEntry"; codelldb spells it "stopOnEntry" (see below).
      "stopAtEntry": false,

      // Environment variables for the debuggee, as name/value pairs.
      "environment": [],

      // "gdb" on Linux/Windows-MinGW, "lldb" on macOS. This is the field
      // that picks the underlying debugger for cppdbg.
      "MIMode": "gdb",

      // gdb-specific startup commands. Pretty-printing makes std::vector,
      // std::string, etc. show readable values instead of raw memory.
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },

    // ════════════════════════════════════════════════════════════════════
    //  cppdbg (GDB) — with arguments, a custom cwd, and environment
    // ════════════════════════════════════════════════════════════════════
    // Shows the shape of a more realistic config: passing flags, running
    // from a fixtures directory, and setting env vars (e.g. logging,
    // library search paths, feature toggles).
    {
      "name": "Debug ‹app› — integration test",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Debug/app",

      // Each token is a separate array element. This is equivalent to:
      //   ./app --config tests/integration.toml --verbose
      "args": ["--config", "tests/integration.toml", "--verbose"],

      // Run from the fixtures dir so the program's relative paths resolve.
      "cwd": "${workspaceFolder}/tests/fixtures",

      "environment": [
        { "name": "RUST_LOG",        "value": "debug" },
        // Help the loader find your freshly-built .so's at runtime.
        { "name": "LD_LIBRARY_PATH", "value": "${workspaceFolder}/build/lib" },
        { "name": "MY_FEATURE_FLAG", "value": "1" }
      ],
      "stopAtEntry": false,
      "MIMode": "gdb"
    },

    // ════════════════════════════════════════════════════════════════════
    //  cppdbg — attach to an already-running process
    // ════════════════════════════════════════════════════════════════════
    // `request: "attach"` instead of "launch". When you start this config,
    // `${command:pickProcess}` pops a process picker. `program` must still
    // point at the binary so the debugger can load matching symbols.
    //
    // Linux note: attaching depends on ownership, ptrace/Yama policy and
    // container permissions. Prefer launching under the debugger when possible;
    // for attach, use a targeted policy approved for your environment rather
    // than disabling ptrace restrictions system-wide.
    // https://github.com/torvalds/linux/blob/v6.12/Documentation/admin-guide/LSM/Yama.rst
    {
      "name": "Attach to running ‹app›",
      "type": "cppdbg",
      "request": "attach",
      "program": "${workspaceFolder}/build/Debug/app",
      "MIMode": "gdb",

      // The picker; or pin a PID with a literal number like  "processId": 12345
      "processId": "${command:pickProcess}"
    },

    // ════════════════════════════════════════════════════════════════════
    //  cppdbg — macOS (LLDB)
    // ════════════════════════════════════════════════════════════════════
    // Identical to the GDB launch config except MIMode is "lldb". On macOS
    // gdb is a pain to codesign, so lldb (or codelldb below) is the path of
    // least resistance. cppdbg requires the LLDB-MI bridge, not the ordinary
    // `lldb` CLI. If the bridge is unavailable, use codelldb instead; otherwise
    // set `miDebuggerPath` to the actual lldb-mi executable when needed.
    {
      "name": "Debug ‹app› (macOS / lldb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Debug/app",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "MIMode": "lldb"
      // , "miDebuggerPath": "/path/to/lldb-mi"
    },

    // ════════════════════════════════════════════════════════════════════
    //  codelldb (LLDB) — READ THIS BEFORE COPYING A cppdbg CONFIG
    // ════════════════════════════════════════════════════════════════════
    // codelldb is a different adapter with its own field names. The single
    // most common mistake is copying a cppdbg block, changing only `type`
    // to "codelldb", and then hitting a hang or silent no-op. Don't. Use
    // the field map below.
    //
    //   cppdbg field           codelldb equivalent          notes
    //   ────────────           ───────────────────          ─────
    //   stopAtEntry            stopOnEntry                   different name!
    //   MIMode: gdb | lldb     (omit entirely)              always LLDB
    //   setupCommands: [...]   initCommands: [...]          LLDB cmds, not GDB
    //   environment:           env:                         see below
    //     [{name,value}]         { "NAME": "value" }        OBJECT, not array!
    //   externalConsole: bool  terminal: <mode>             different types/values (below)
    //   (no equivalent)        sourceLanguages: ["rust"]    nicer Rust view
    //
    // ENVIRONMENT SHAPE DIFFERS
    //   cppdbg wants an ARRAY of {name, value} objects.
    //   codelldb wants a single OBJECT mapping names to values:
    //       "env": { "RUST_LOG": "debug", "MY_FLAG": "1" }
    //   Mixing these up is the second most common codelldb mistake.
    //
    // THE `terminal` FIELD — and the Windows hang
    //   codelldb's `terminal` controls where the debuggee's stdio goes. The
    //   VALUES are codelldb's own — NOT cppvsdbg's "internalConsole" etc.:
    //     "console"    → the DEBUG CONSOLE (the dap-repl buffer in nvim)
    //     "integrated" → an integrated terminal, opened via a runInTerminal
    //                    handshake between adapter and nvim-dap   (DEFAULT)
    //     "external"   → a separate OS terminal window
    //
    //   These are cross-platform adapter values, but the client must support
    //   the requested terminal. For "external", configure nvim-dap's
    //   dap.defaults.codelldb.external_terminal (command/args); without it,
    //   nvim-dap falls back to an integrated terminal. CodeLLDB has no
    //   `console` field; cppvsdbg uses that field, while cppdbg normally uses
    //   `externalConsole`. Neither changes CodeLLDB's terminal selection.
    //
    //   On WINDOWS, prefer "console". codelldb's default ("integrated")
    //   relies on the runInTerminal reverse-request; this has hung in the
    //   tested Windows setup while waiting for the terminal handshake.
    //   "console" avoids that path when interactive stdin is unnecessary.
    //   (Separately, the auto-session config closes [dap-*] windows before a save and wipes
    //   those buffers on exit, because a session can't recreate them — see
    //   lua/plugins/session.lua.)
    //
    //   On Linux/macOS, "integrated" is fine if your program needs an
    //   interactive stdin TTY; otherwise "console" keeps everything in nvim.
    //
    // STDIN
    //   The dap-repl accepts debugger commands/expressions, not debuggee
    //   stdin. For interactive input use an integrated terminal, or a
    //   configured external terminal, and verify it on your platform.
    //   If your application accepts an input-file argument, that also avoids
    //   an interactive terminal; args alone do not redirect stdin.
    {
      "name": "Debug ‹app› (codelldb)",
      "type": "codelldb",
      "request": "launch",

      // Same as cppdbg: path to the compiled binary, built with symbols.
      "program": "${workspaceFolder}/build/Debug/app",

      // Array of args, exactly like cppdbg.
      "args": [],

      "cwd": "${workspaceFolder}",

      // OBJECT form — note this is NOT the cppdbg array-of-objects shape.
      "env": {
        // "RUST_LOG": "debug"
      },

      // codelldb's spelling of stopAtEntry.
      "stopOnEntry": false,

      // Keep output in nvim's debug console; not an interactive stdin TTY.
      // Avoids the Windows terminal handshake described above.
      "terminal": "console",

      // OPTIONAL: reduce symbol-loading work for large native programs.
      // This can help slow launches on any OS, including repeated launches.
      // The first command disables eager symbol-table loading; the second
      // enables module debug info on demand. Work can move to later lookups.
      // File/line breakpoints remain supported, but inline function-name
      // breakpoints, type lookups and stripped global-name lookups may fail
      // until the relevant module's debug info is enabled. If that happens,
      // or LLDB rejects the setting, remove the second line and start a new
      // session. These are project choices, not injected into every launch.
      // Details: docs/debug-terminal-configuration.md#codelldb-symbol-loading-for-slow-launches
      "initCommands": [
        "settings set target.preload-symbols false",
        "settings set symbols.load-on-demand true"
      ]

      // Rust users: uncomment for nicer enum/Option/Result rendering and
      // to load Rust's LLDB formatters.
      // , "sourceLanguages": ["rust"]
    },

    // ════════════════════════════════════════════════════════════════════
    //  codelldb — attach by PID
    // ════════════════════════════════════════════════════════════════════
    // codelldb attach. Use `pid` with the process picker, or hard-code a
    // number. `program` is optional for attach but helps symbol resolution.
    {
      "name": "Attach ‹app› (codelldb)",
      "type": "codelldb",
      "request": "attach",
      "program": "${workspaceFolder}/build/Debug/app",
      "pid": "${command:pickProcess}"
    },

    // ════════════════════════════════════════════════════════════════════
    //  cppdbg — CMake multi-config / preset output path
    // ════════════════════════════════════════════════════════════════════
    // If you build with CMake presets or a multi-config generator, the
    // binary lives under a per-preset / per-config directory. There's no
    // ${command:cmake.activeConfigurePresetName} in nvim-dap (that's a VS
    // Code cmake-tools variable), so spell the path out, or use an input
    // prompt (see the very bottom) to choose at launch.
    {
      "name": "Debug ‹app› (CMake preset: default)",
      "type": "cppdbg",
      "request": "launch",
      // out-of-source preset layout, e.g. `cmake --preset default`:
      "program": "${workspaceFolder}/out/build/default/app",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "MIMode": "gdb",
      "setupCommands": [
        { "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    },

    // ════════════════════════════════════════════════════════════════════
    //  cppdbg — post-mortem: open a core dump
    // ════════════════════════════════════════════════════════════════════
    // Debug a crash after the fact. `coreDumpPath` loads a core file
    // instead of launching the program; you get the stack/locals at the
    // moment of the crash but can't step (the process is dead).
    //   Linux: enable cores with `ulimit -c unlimited`; find them per
    //   /proc/sys/kernel/core_pattern (often `core` in cwd, or under
    //   /var/lib/systemd/coredump via coredumpctl).
    {
      "name": "Debug core dump (cppdbg)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Debug/app",
      "coreDumpPath": "${workspaceFolder}/core",
      "MIMode": "gdb",
      "setupCommands": [
        { "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    },

    // codelldb uses a custom target and skips process creation for a core.
    // initCommands alone is insufficient: a normal launch would replace
    // that target and start a fresh process instead of inspecting the core.
    // https://github.com/vadimcn/codelldb/blob/v1.12.3/MANUAL.md#inspecting-a-core-dump
    // {
    //   "name": "Debug core dump (codelldb)",
    //   "type": "codelldb", "request": "attach",
    //   "targetCreateCommands": ["target create \"${workspaceFolder}/build/Debug/app\" --core \"${workspaceFolder}/core\""],
    //   "processCreateCommands": []
    // },

    // ════════════════════════════════════════════════════════════════════
    //  cppdbg — remote debugging over gdbserver
    // ════════════════════════════════════════════════════════════════════
    // The program runs on another machine/container/board under
    // gdbserver; your local gdb connects to it. Restrict access to the debug
    // port and use an SSH tunnel or trusted private connection: gdbserver
    // does not authenticate clients. `program`
    // is the LOCAL copy of the binary (for symbols); paths on the target
    // are mapped if they differ.
    {
      "name": "Debug remote (gdbserver)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Debug/app",
      "MIMode": "gdb",
      // host:port of gdbserver
      "miDebuggerServerAddress": "localhost:1234",
      "cwd": "${workspaceFolder}",
      // If the target's source paths differ from yours, remap so
      // breakpoints bind: "sourceFileMap": { "/build/on/target": "${workspaceFolder}" }
      "setupCommands": [
        { "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    }

    // ════════════════════════════════════════════════════════════════════
    //  Windows native (MSVC) — cppvsdbg, NOT registered
    // ════════════════════════════════════════════════════════════════════
    // To debug a binary built with the MSVC toolchain (cl.exe / PDBs),
    // VS Code uses `"type": "cppvsdbg"`. That adapter ships with VS Code's
    // C/C++ extension and is NOT registered by this config, so it won't
    // work out of the box here. CodeLLDB can read matching PDBs through LLDB;
    // verify the features your MSVC application needs. Use "terminal":"console"
    // as shown above. Documented here only so you know why a copied
    // cppvsdbg config from a VS Code project does nothing.
    // {
    //   "name": "Debug (MSVC / cppvsdbg)",
    //   "type": "cppvsdbg", "request": "launch",
    //   "program": "${workspaceFolder}/build/Debug/app.exe",
    //   "args": [], "cwd": "${workspaceFolder}", "console": "integratedTerminal"
    // }
  ],

  // ══════════════════════════════════════════════════════════════════════
  //  inputs — prompt for a value at launch. nvim-dap supports "pickString"
  //  and "promptString" inputs, referenced as ${input:id}; VS Code's
  //  "command" inputs aren't supported. Handy for picking a build config or
  //  passing ad-hoc args without editing this file.
  // ══════════════════════════════════════════════════════════════════════
  "inputs": [
    // Reference as "${input:buildType}" inside a program path, e.g.
    //   "program": "${workspaceFolder}/out/build/${input:buildType}/app"
    // {
    //   "id": "buildType",
    //   "type": "pickString",
    //   "description": "Which build to debug?",
    //   "options": ["Debug", "RelWithDebInfo", "Release"],
    //   "default": "Debug"
    // }
  ]
}
